DATABASE_URL="file:./prisma/dev.db"

# LLM 채점(evaluator.ts, OpenAI API)에 필수 — docs/evaluation.md 참고. 비워두면 앱은 정상
# 동작하지만 LLM 채점(품질 축의 일부)만 기록되지 않는다(대시보드에 배너로 안내됨).
OPENAI_API_KEY=

# 벤치마크 대상 claude CLI(subprocess)는 기본적으로 이 컴퓨터의 구독 로그인(OAuth)을 쓴다(--safe-mode).
# 아래 키는 --bare 대안 경로(API 키 종량제)로 전환할 때만 필요 — docs/cli-spec.md 참고.
# ANTHROPIC_API_KEY=

# 실행마다 격리된 워크스페이스를 생성할 위치(프로젝트 밖, 사람이 눈으로 구경하기 편한 경로).
# 비워두면 기본값으로 "work" 디렉터리(프로젝트 루트 기준 두 단계 위) 아래 vibecheck-runs를 쓴다
# (예: VibeCheck 프로젝트가 <work>\project\VibeCheck에 있으면 기본값은 <work>\vibecheck-runs).
# docs/architecture.md 참고.
# RUN_WORKSPACES_DIR=

# 워크스페이스 생성 직후 VS Code 창을 자동으로 여는지 여부(구경용, best-effort — 실패해도
# 벤치마크 실행에는 영향 없음). 기본 켜짐. 반복 실행되는 검증 스크립트 등에서는 "false"로 꺼라.
# VIBECHECK_OPEN_VSCODE=false
