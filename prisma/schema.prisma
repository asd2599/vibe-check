// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// src/lib/runner.ts의 RunResult(completed/disqualified/failed 3-way union, mode=auto)와
// src/lib/manualRun.ts의 ManualRunFinalEstimate(completed/disqualified만, mode=manual — 수동 모드는
// CLI가 스스로 비정상 종료하는 경로가 없어 "failed"가 없다)를 하나의 테이블에 저장한다.
// status/mode로 구분하고, 상태별 필드는 전부 nullable이다.
enum RunStatus {
  completed
  disqualified
  failed
}

enum DisqualifyReason {
  token_limit
  time_limit
  // 2026-08-10 추가, mode=manual 전용. 구독 플랜의 사용 한도는 토큰 1:1 합이 아니라 모델·토큰
  // 종류로 가중된 값(≈비용)으로 소모되므로, 토큰 하드컷과 별개로 비용 하드컷을 둔다
  // (src/lib/problems.ts의 maxCostUsd 주석에 실측 근거).
  cost_limit
}

// auto: 기존 헤드리스 벤치마크(runner.ts의 runBenchmark(), -p --output-format stream-json).
// manual: 사람이 VS Code + 대화형 CLI로 직접 푸는 걸 측정(manualRun.ts). CLI 공식 usage 값이
// 애초에 존재하지 않으므로(대화형 세션이라 -p/--output-format json 결과 자체가 없음) completed
// 상태에서도 harnessEstimate* 필드로 값을 채운다(아래 참고). 기본값 auto — 기존 row는 전부
// 이 마이그레이션 이전에 만들어졌으므로 auto로 채워지는 게 맞다(docs/architecture.md 변경 이력).
enum RunMode {
  auto
  manual
}

model Run {
  id            String    @id // runner.ts/manualRun.ts의 runId를 그대로 PK로 사용
  status        RunStatus
  mode          RunMode   @default(auto)
  problemId     String
  workspacePath String
  startedAt     DateTime
  durationMs    Int // 러너가 직접 측정한 벽시계 시간(모든 상태 공통).
  // auto: subprocess 시작~종료. manual: 세션 시작~"완료" 클릭(또는 강제종료) 시점.

  // completed 상태인 Run에만 생성됨 (실격/실패는 평가 자체를 하지 않음, docs/evaluation.md)
  evaluation Evaluation?

  // 구독 로그인 경로의 5시간 사용량 한도(rate_limit_event) — 마지막으로 관찰된 상태 문자열만 기록.
  // 정보성 필드이며 판단 로직 없음 (docs/cli-spec.md 참고)
  rateLimitStatus String?

  // --- completed 전용 (일부는 failed의 exitCode와 공유) ---
  exitCode                      Int? // completed/failed 공통 (subprocess exit code)
  sessionId                     String? // completed/disqualified 공통
  resultText                    String?
  numTurns                      Int?
  totalCostUsdEstimate          Float? // 추정치 — CLI의 total_cost_usd 그대로, 실청구액과 다를 수 있음 (CLAUDE.md)
  // usage.* — CLI가 보고한 공식 값 (stream-json 마지막 result 줄)
  usageInputTokens              Int?
  usageOutputTokens             Int?
  usageCacheCreationInputTokens Int?
  usageCacheReadInputTokens     Int?
  cliReportedDurationMs         Int? // 참고용(CLI 자체 보고), 실시간 한도 집행에는 쓰이지 않음

  // 사람이 단계를 다 통과하지 못한 채 "포기"를 눌러 끝낸 run인지 (2026-08-12, mode=manual 전용).
  //
  // status는 그대로 completed이고 채점도 정상 수행한다 — 어디까지 갔는지가 점수로 남아야 하기
  // 때문이다(못 푼 단계는 hiddenTestsPath가 이식하는 히든 테스트가 이미 실패시킨다). 이 필드는
  // "끝까지 풀고 자동 완료된 run"과 "중도에 손 든 run"을 이력에서 구분하기 위한 표시용이다.
  //
  // 왜 disqualifyReason에 값을 하나 더 넣지 않았나: 그 필드는 "status가 disqualified일 때만 값이
  // 있다"는 불변식으로 쓰이고 있어서(아래 주석, StatusBadge의 렌더 조건), completed인 run에 값을
  // 넣으면 그 전제가 깨진다. 포기는 실격이 아니라 정상 종료의 한 종류다.
  abandoned Boolean @default(false)

  // --- disqualified 전용(mode=auto/manual 공통) + completed 상태에서도 mode=manual이면 쓰인다 ---
  disqualifyReason         DisqualifyReason? // mode 무관, disqualified일 때만 값 있음
  // 하네스 추정치 — CLI 공식 값이 아니라 러너가 직접 집계한 값.
  //   mode=auto  : disqualified 전용. 한도 초과로 죽은 run은 CLI의 최종 result 줄을 못 받으므로
  //                stdout stream-json을 읽으며 누적한 값이 유일한 수치다(정상 종료 completed는
  //                위 usage* 필드의 CLI 공식 값을 쓴다 — 이 필드는 null).
  //   mode=manual: completed든 disqualified든 항상 이 필드를 쓴다 — 애초에 대화형 세션이라
  //                CLI 공식 usage 값 자체가 없다(manualRun.ts가 세션 트랜스크립트를 폴링해서
  //                집계한 추정치, 부정확할 수 있음 — docs/cli-spec.md, src/lib/manualRun.ts 상단 주석).
  harnessEstimateTokens    Int?
  harnessEstimateElapsedMs Int?

  // --- 비용 축(2026-08-07 추가, mode=manual 전용) ---
  // 위 harnessEstimateTokens는 모델과 토큰 종류를 구분하지 않는 단순 합계라, 같은 숫자가 실제로는
  // 몇 배씩 다른 소비를 가리킬 수 있었다(Fable 5 output 단가는 Sonnet 5의 3.3배, 1시간 캐시 쓰기는
  // 캐시 읽기의 20배). 그래서 모델별·토큰종류별 분해를 원자료로 같이 저장한다.
  //
  // harnessEstimateUsageByModel이 원자료(source of truth)다: { "claude-opus-5": { inputTokens,
  // outputTokens, cacheWrite5mTokens, cacheWrite1hTokens, cacheReadTokens }, ... } 형태이며,
  // 화면에서는 이 값에 현재 단가 테이블(src/lib/pricing.ts)을 다시 곱해서 보여준다 — 그래야 단가
  // 테이블에 새 모델을 추가했을 때 과거 run도 소급해서 제대로 계산된다.
  // harnessEstimateCostUsd는 저장 시점의 스냅샷(목록 정렬/폴백용)이며, 구독 로그인이라 실제 청구가
  // 아니라 "API 종량제로 돌렸다면" 기준의 환산 추정치다(CLAUDE.md의 추정치 표기 원칙).
  harnessEstimateCostUsd      Float?
  harnessEstimateUsageByModel Json?
  // /compact 근사치(compact_boundary.preTokens)가 위 집계에 얼마나 섞여 들어갔는지 — 추정 위에 얹은
  // 또 하나의 가정이므로 신뢰도를 화면에서 밝히기 위해 따로 남긴다(src/lib/manualRun.ts 주석 참고).
  harnessEstimateCompactTokens Int?
  // 위 수치들의 출처(2026-08-10 추가, mode=manual 전용): "telemetry" | "transcript".
  //   telemetry  : 측정 대상 CLI가 OpenTelemetry로 직접 보고한 값(= CLI 공식 값). 트랜스크립트에
  //                usage가 안 남는 배경 호출(제목 생성 Haiku 등)과 /compact 실제 비용까지 포함하고,
  //                비용도 CLI가 계산한 값이라 harnessEstimateUsageByModel에 단가를 다시 곱하지 않는다.
  //   transcript : 예전 방식(세션 .jsonl 폴링 + 정가 테이블 환산). 텔레메트리가 안 붙었을 때의 폴백.
  // null이면 이 필드가 생기기 전(2026-08-10 이전)에 저장된 run이며, 전부 transcript 방식이다.
  harnessEstimateSource String?

  // --- failed 전용 ---
  signal     String? // NodeJS.Signals (예: "SIGTERM"), 없으면 null
  stderrTail String?

  @@index([status])
  @@index([problemId])
  @@index([startedAt])
}

// 페이즈 5(eval-engineer): completed 상태인 Run에 대해서만 생성되는 1:1 평가 레코드.
// 효율성(Run의 토큰/시간/비용)과 품질(아래 테스트/채점)은 절대 하나의 점수로 합치지 않는다
// (CLAUDE.md 핵심 원칙) — 그래서 Run에 얹지 않고 별도 모델로 분리했다.
// 자동 테스트와 LLM 채점은 서로 독립적으로 기록한다: 하나가 실패해도(예: OpenAI 호출 에러)
// 다른 하나(테스트 결과)는 그대로 남는다 (docs/evaluation.md).
model Evaluation {
  id    String @id @default(cuid())
  runId String @unique
  run   Run    @relation(fields: [runId], references: [id])

  // --- 자동 테스트 (problems/*.json의 testCommand) ---
  // testCommand가 없는 문제는 이 셋이 전부 null — 실패로 취급하지 않는다 (docs/evaluation.md).
  testPassed   Boolean?
  testOutput   String? // stdout+stderr 일부 (truncate)
  testExitCode Int?

  // --- LLM 채점 (OpenAI API, Claude Code CLI와는 별도 벤더 — self-preferencing bias 방지) ---
  // 문제의 rubric(string[]) 항목별 점수/근거. [{ criterion, score, reasoning }, ...] 형태.
  // SQLite에서도 Prisma Json 타입은 지원된다(실측 확인, TEXT 컬럼에 직렬화되어 저장됨).
  judgeScores         Json?
  judgeOverallComment String?
  judgeModel          String? // 실제로 응답한 OpenAI 모델명(response.model) — 요청 시 지정한 모델과 다를 수 있어 응답값을 그대로 기록
  // 아래 비용/토큰은 채점 호출(OpenAI) 전용 — Run.totalCostUsdEstimate(벤치마크 대상 CLI 비용)와 절대 합산하지 않는다.
  judgeCostUsd        Float? // 추정치 — 로컬 정가 계산, 실청구액과 다를 수 있음 (CLAUDE.md)
  judgeInputTokens    Int?
  judgeOutputTokens   Int?

  evaluatedAt DateTime

  @@index([runId])
}
